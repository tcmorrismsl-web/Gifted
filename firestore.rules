rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // The Google accounts that make up the household.
    function isHousehold() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in [
          'tcmorris.msl@gmail.com',
          'twmorris.2021@gmail.com',
          'whitneyamburgey3@gmail.com'
        ];
    }

    // Shared household lists: everyone in the household can read and write.
    match /gifts/{giftId} {
      allow read, write: if isHousehold();
    }
    match /people/{personId} {
      allow read, write: if isHousehold();
    }
    match /meta/{docId} {
      allow read, write: if isHousehold();
    }
    match /events/{eventId} {
      allow read, write: if isHousehold();
    }

    // Who's who: everyone in the household can read; each account writes only its own entry.
    match /members/{uid} {
      allow read: if isHousehold();
      allow write: if isHousehold() && request.auth.uid == uid;
    }

    // Private lists: only the account that owns the list can read or write it.
    match /private/{uid}/{rest=**} {
      allow read, write: if isHousehold() && request.auth.uid == uid;
    }
  }
}
